# Этап 1: сборка Vite
FROM node:20-alpine AS builder
WORKDIR /app

# Копируем package.json
COPY frontend/package.json ./

# Чистая установка зависимостей
RUN npm install

# Копируем исходники (благодаря .dockerignore node_modules не попадут)
COPY frontend/ ./

# Продакшн сборка
RUN npm run build

# Этап 2: Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]